# Copy this file to .env.dev and .env.prod, then fill in the real values.
# These files are consumed at build time by `envied` (see lib/core/config/env/).
# .env.dev and .env.prod are gitignored; only this example is committed.

# Base URL for the REST API (used by the Dio/Retrofit client).
BASE_URL=

# API key / client secret for the backend.
API_KEY=
